{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "status",
    "application",
    "version",
    "timestamp"
  ],
  "properties": {
    "status": {
      "type": "string",
      "const": "UP"
    },
    "application": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
