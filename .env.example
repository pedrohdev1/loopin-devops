# Copy this file to .env and generate a fresh local JWT secret before starting.
# Never commit .env or place credentials in source code.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
JWT_SECRET=REPLACE_WITH_BASE64_RANDOM_SECRET
JWT_EXPIRATION_MS=3600000
APP_BOOTSTRAP_TOKEN=REPLACE_WITH_A_LONG_RANDOM_LOCAL_TOKEN
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
